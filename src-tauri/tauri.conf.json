{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyloom", "version": "0.1.0", "identifier": "app.keyloom.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Keyloom", "url": "spike.html", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 640 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" } },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "Offline piano practice", "category": "Music", "windows": { "webviewInstallMode": { "type": "skip" }, "nsis": { "installMode": "currentUser" } } }
}
