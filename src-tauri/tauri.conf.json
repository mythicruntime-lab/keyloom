{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyloom",
  "version": "0.1.2",
  "identifier": "app.keyloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keyloom",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Offline piano practice",
    "category": "Music",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../HANDOFF.md": "HANDOFF.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/",
      "../docs/": "docs/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
